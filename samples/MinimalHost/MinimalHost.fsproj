<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>MinimalHost</RootNamespace>
    <Description>Minimal Giraffe web host for Legate sessions: open/prompt/reply/abort endpoints with a per-session SSE event stream.</Description>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- Compile order is explicit: register every new file here, in dependency order. -->
  <ItemGroup>
    <Compile Include="ScriptedTransport.fs" />
    <Compile Include="HostWiring.fs" />
    <Compile Include="Routes.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Legate/Legate.fsproj" />
    <ProjectReference Include="../../src/Legate.Cluster.Kubernetes/Legate.Cluster.Kubernetes.fsproj" />
    <ProjectReference Include="../../src/Legate.Llm.Google/Legate.Llm.Google.fsproj" />
    <ProjectReference Include="../../src/Legate.Llm.OpenAI/Legate.Llm.OpenAI.fsproj" />
    <ProjectReference Include="../../src/Legate.Storage.InMemory/Legate.Storage.InMemory.fsproj" />
    <ProjectReference Include="../../src/Legate.Workspace.Process/Legate.Workspace.Process.fsproj" />
  </ItemGroup>

  <!-- Microsoft.Extensions.* ships in the Microsoft.AspNetCore.App
       framework reference above: only non-framework packages are listed. -->
  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="Giraffe" />
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" />
  </ItemGroup>

</Project>
