<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Legate</RootNamespace>
    <Description>Contracts for the Legate agent harness: domain types, store, tool, workspace, and policy interfaces. Depends on Microsoft.Extensions.AI.Abstractions and Ulid.</Description>
  </PropertyGroup>

  <!-- Compile order is explicit: register every new file here, in dependency order. -->
  <ItemGroup>
    <Compile Include="Tenancy.fs" />
    <Compile Include="Identifiers.fs" />
    <Compile Include="Exceptions.fs" />
    <Compile Include="Seams.fs" />
    <Compile Include="Blobs.fs" />
    <Compile Include="Messages.fs" />
    <Compile Include="UntrustedContext.fs" />
    <Compile Include="Permissions.fs" />
    <Compile Include="Turns.fs" />
    <Compile Include="Llm.fs" />
    <Compile Include="ModelCatalog.fs" />
    <Compile Include="LegateOptions.fs" />
    <Compile Include="Agents.fs" />
    <Compile Include="HostHooks.fs" />
    <Compile Include="Sessions.fs" />
    <Compile Include="WorkspaceRuntime.fs" />
    <Compile Include="Policies.fs" />
    <Compile Include="ToolSources.fs" />
    <Compile Include="Events.fs" />
    <Compile Include="Cells.fs" />
    <Compile Include="SessionsStore.fs" />
    <Compile Include="SessionEventStore.fs" />
    <Compile Include="AgentStore.fs" />
    <Compile Include="AgentPackages.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" />
    <PackageReference Include="Ulid" />
  </ItemGroup>

</Project>
