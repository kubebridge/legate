<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Legate.Llm</RootNamespace>
    <Description>Native Anthropic LLM provider for the Legate agent harness: ILlmProvider over the official Anthropic SDK surfaced as IChatClient through the SDK's own adapter, with thinking-mode controls and provider-shaped error mapping.</Description>
  </PropertyGroup>

  <!-- Compile order is explicit: register every new file here, in dependency order. -->
  <ItemGroup>
    <Compile Include="AssemblyInfo.fs" />
    <Compile Include="AnthropicLlmOptions.fs" />
    <Compile Include="AnthropicProvider.fs" />
    <Compile Include="LlmBuilderExtensions.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Legate.Abstractions/Legate.Abstractions.fsproj" />
    <ProjectReference Include="../Legate/Legate.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Anthropic" />
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
  </ItemGroup>

</Project>
