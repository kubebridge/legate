<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Legate</RootNamespace>
    <Description>A durable Akka.NET runtime for tool-using AI agents: sessions you can prompt, steer, abort, resume, and replay.</Description>
  </PropertyGroup>

  <!-- Compile order is explicit: register every new file here, in dependency order. -->
  <ItemGroup>
    <Compile Include="AssemblyInfo.fs" />
    <Compile Include="Seams.fs" />
    <Compile Include="SkillDiscovery.fs" />
    <Compile Include="PromptComposition.fs" />
    <Compile Include="Tools/FileTools.fs" />
    <Compile Include="BuiltinEditTools.fs" />
    <Compile Include="BuiltinSearchTools.fs" />
    <Compile Include="LlmCoordinator.fs" />
    <Compile Include="ClaimHeartbeat.fs" />
    <Compile Include="ClaimFence.fs" />
    <Compile Include="JournalWriter.fs" />
    <Compile Include="Transcripts.fs" />
    <Compile Include="SessionEventBus.fs" />
    <Compile Include="LlmStreaming.fs" />
    <Compile Include="StopArbitration.fs" />
    <Compile Include="WorkspaceLayout.fs" />
    <Compile Include="DownloadUrlTool.fs" />
    <Compile Include="TurnLoop.fs" />
    <Compile Include="AskUserTool.fs" />
    <Compile Include="SkillTool.fs" />
    <Compile Include="ExecTool.fs" />
    <Compile Include="Compaction.fs" />
    <Compile Include="LegateOptionsBinding.fs" />
    <Compile Include="LegateDefaults.fs" />
    <Compile Include="LegateStartupValidation.fs" />
    <Compile Include="SessionActor.fs" />
    <Compile Include="SessionPermissions.fs" />
    <Compile Include="LocalActorSystem.fs" />
    <Compile Include="Agents/AgentFileParser.fs" />
    <Compile Include="Agents/SubAgents.fs" />
    <Compile Include="TaskTool.fs" />
    <Compile Include="LegateBuilder.fs" />
    <Compile Include="Agents/FileAgentStore.fs" />
    <Compile Include="AddLegate.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Legate.Abstractions/Legate.Abstractions.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Akka" />
    <PackageReference Include="Akka.FSharp" />
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>

</Project>
