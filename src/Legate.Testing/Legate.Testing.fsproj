<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <RootNamespace>Legate.Testing</RootNamespace>
    <Description>Test support for Legate: the shared store conformance suite, a manual-advance clock, and the scripted chat client and session harness. Referenced by test projects; not for host use.</Description>
  </PropertyGroup>

  <!-- Compile order is explicit: register every new file here, in dependency order. -->
  <ItemGroup>
    <Compile Include="TestClock.fs" />
    <Compile Include="SessionStoreConformance.fs" />
    <Compile Include="SessionEventStoreConformance.fs" />
    <Compile Include="AgentStoreConformance.fs" />
    <Compile Include="BlobStoreConformance.fs" />
    <Compile Include="AgentPackageStoreConformance.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Legate.Abstractions/Legate.Abstractions.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
  </ItemGroup>

</Project>