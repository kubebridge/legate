<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Legate.Llm.Anthropic.Tests</RootNamespace>
  </PropertyGroup>

  <!-- Compile order is explicit: register every new file here, in dependency order. -->
  <ItemGroup>
    <Compile Include="AnthropicProviderTests.fs" />
    <Compile Include="AnthropicRegistrationTests.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Legate.Abstractions/Legate.Abstractions.fsproj" />
    <ProjectReference Include="../../src/Legate/Legate.fsproj" />
    <ProjectReference Include="../../src/Legate.Llm.Anthropic/Legate.Llm.Anthropic.fsproj" />
    <ProjectReference Include="../../src/Legate.Testing/Legate.Testing.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Anthropic" />
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="FsUnit.xUnit" />
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

</Project>
