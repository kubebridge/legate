<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Legate.Coordination.Redis.Tests</RootNamespace>
  </PropertyGroup>

  <!-- Compile order is explicit: register every new file here, in dependency order.
       The Docker-backed suites compile on non-Windows only: xUnit 2.9 has no
       dynamic-skip mechanism (verified against the 2.9.3 runner assemblies),
       so the Windows CI leg excludes them at compile time and never attempts
       a container. A Windows host with Linux-container Docker opts back in
       explicitly (-p:LegateRedisDocker=true). The gate
       (RedisTestEnvironment) and the Docker-free options, script, and
       compensation tests compile everywhere. -->
  <ItemGroup>
    <Compile Include="TestAssembly.fs" />
    <Compile Include="RedisTestEnvironment.fs" />
    <Compile Include="DistributedCoordinationOptionsTests.fs" />
    <Compile Include="RedisScriptsTests.fs" />
    <Compile Include="CompensationTests.fs" />
    <Compile Include="DistributedAdmissionClientTests.fs" />
    <Compile Include="CombinedLimitTests.fs" Condition="'$(OS)' != 'Windows_NT' or '$(LegateRedisDocker)' == 'true'" />
    <Compile Include="FifoAndTtlTests.fs" Condition="'$(OS)' != 'Windows_NT' or '$(LegateRedisDocker)' == 'true'" />
    <Compile Include="OwnerFencingTests.fs" Condition="'$(OS)' != 'Windows_NT' or '$(LegateRedisDocker)' == 'true'" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Legate.Abstractions/Legate.Abstractions.fsproj" />
    <ProjectReference Include="../../src/Legate/Legate.fsproj" />
    <ProjectReference Include="../../src/Legate.Coordination.Redis/Legate.Coordination.Redis.fsproj" />
    <ProjectReference Include="../../src/Legate.Testing/Legate.Testing.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="FsUnit.xUnit" />
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="StackExchange.Redis" />
    <PackageReference Include="Testcontainers.Redis" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

</Project>
